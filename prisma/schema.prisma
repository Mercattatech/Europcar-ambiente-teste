generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContentBlock {
  id         String   @id @default(uuid())
  key        String   @unique
  value_ptBR String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model XRSConfig {
  id               String   @id @default(uuid())
  callerCode       String
  password         String
  poaCid           String?  @default("57269673")
  etoZeroExcessCid String?  @default("56935495")
  etoZeroExcessBa  String?  @default("73804373")
  etoExcessCid     String?  @default("56935466")
  etoExcessBa      String?  @default("73675595")
  exoCid           String?  @default("57269673")
  exoIata          String?  @default("02170722")
  updatedAt        DateTime @updatedAt
}

model CieloConfig {
  id                String   @id @default(uuid())
  merchantId        String
  merchantKey       String
  isSandbox         Boolean  @default(true)
  clientId3ds       String?  // Credencial exclusiva Braspag 3DS (ClientId)
  clientSecret3ds   String?  // Credencial exclusiva Braspag 3DS (ClientSecret)
  establishmentCode String?  // Número de afiliação Cielo (Erro 605)
  merchantName      String?  // Nome fantasia exibido no 3DS (Erro 606), ex: 'Europcar Brasil'
  mcc               String?  // Merchant Category Code (Erro 607): 7512 = Car Rental Agencies
  updatedAt         DateTime @updatedAt
}

model LocalReservation {
  id                String   @id @default(uuid())
  resNumber         String?  @unique
  merchantOrderId   String   @unique
  customerData      Json
  amountInCents     Int?
  status            String
  operationalStatus String?  @default("R") // R, S, CF, CC, CP, CO, TD, NS
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LogXRS {
  id          String   @id @default(uuid())
  action      String   // e.g. "getMultipleRates", "bookReservation"
  sourceFile  String   // e.g. "getMultipleRates/route.ts"
  endpoint    String   // XRS URL called
  xmlRequest  String   // full XML sent
  xmlResponse String   // full XML received
  httpStatus  Int?     // HTTP status code
  durationMs  Int?     // response time in ms
  hasError    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LogCielo {
  id        String   @id @default(uuid())
  endpoint  String
  payload   String
  response  String
  createdAt DateTime @default(now())
}

model CityStationOverride {
  id           String @id @default(uuid())
  stationCode  String @unique
  friendlyName String
}

// NextAuth Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER or ADMIN
  status        String    @default("ACTIVE") // ACTIVE or BLOCKED
  phone         String?
  city          String?
  cpf           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt
  accounts       Account[]
  sessions       Session[]
  supportTickets SupportTicket[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// System Customizations (Promotions & Extras)
model Extra {
  id          String   @id @default(cuid())
  name        String
  description String?
  pricePerDay Float
  type        String   // "PROTECTION" or "ADDON"
  active      Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Promotion {
  id            String    @id @default(cuid())
  title         String
  subtitle      String?
  description   String?
  discountValue Float?    // e.g 20 for 20%
  imageUrl      String?
  contractID    String?   // Europcar XRS contract code e.g. "45944876"
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  status        String    @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Maintenance Mode Configuration
model MaintenanceConfig {
  id          String    @id @default(cuid())
  redirectUrl String    // URL de redirecionamento durante manutenção
  isActive    Boolean   @default(false)
  returnDate  DateTime? // Data para retorno automático
  reason      String?   // Motivo da manutenção (opcional)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Loyalty / Fidelity Programs
model LoyaltyProgram {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Car Image Overrides
model CarImageOverride {
  carCode   String   @id
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Car Category Friendly Name Overrides
model CarCategoryOverride {
  carCode      String   @id
  friendlyName String
  onRequest    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Terms & Conditions Documents (PDF / DOC uploads)
model TermsDocument {
  id        String   @id @default(cuid())
  type      String   @unique // RESERVA, PAIS, BRASIL_ONLINE
  fileName  String
  mimeType  String   @default("application/pdf")
  fileData  String   // base64-encoded file content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Agent Settings
model AIAgentConfig {
  id              String   @id @default(cuid())
  isActive        Boolean  @default(true)
  masterPrompt    String?  @db.Text
  positivePrompt  String?  @db.Text
  negativePrompt  String?  @db.Text
  updatedAt       DateTime @updatedAt
}

// Customer Journey Tracking
model CustomerJourney {
  id                String   @id @default(cuid())
  sessionId         String   // Unique browser session ID
  userId            String?  // Logged-in user ID (if any)

  // Step 1: Search
  pickupStation     String?
  pickupStationName String?
  returnStation     String?
  returnStationName String?
  pickupDate        String?
  returnDate        String?
  pickupTime        String?
  returnTime        String?
  country           String?
  contractID        String?

  // Step 2: Vehicle Selection
  selectedCar       String?
  selectedCarName   String?
  carPrice          Float?

  // Step 3: Extras
  selectedExtras    Json?

  // Step 4: Checkout
  paymentMethod     String?

  // Step 5: Result
  resNumber         String?

  // Metadata
  currentStep       Int      @default(1)
  status            String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  abandonedAt       String?

  // Device info
  userAgent         String?  @db.Text
  ipAddress         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@index([currentStep])
}

// AI Knowledge Base Documents
model AIKnowledgeDoc {
  id            String   @id @default(cuid())
  fileName      String
  fileType      String   // "pdf", "txt", "image"
  extractedText String   @db.Text
  active        Boolean  @default(true)
  sizeBytes     Int?     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

// AI Conversation Logs (for learning)
model AIConversationLog {
  id            String   @id @default(cuid())
  sessionId     String
  messages      String   @db.Text  // JSON string of all messages
  approved      Boolean  @default(false)  // admin marked as good example
  sessionStart  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([approved])
  @@index([sessionStart])
}

// XRS API Monitor — health check + WhatsApp alerts
model XrsMonitorConfig {
  id                        String    @id @default(cuid())
  enabled                   Boolean   @default(false)
  intervalMinutes           Int       @default(7)
  messagingIntervalSeconds  Int       @default(10)
  whatsappNumbers           String    @default("[]") @db.Text   // JSON array of phone numbers
  testStation               String    @default("LIST01")
  errorMessageTemplate      String    @default("⚠️ ALERTA: A API XRS (Europcar) está FORA DO AR desde {DATA} às {HORA}. Erro: {ERRO}") @db.Text
  recoveryMessageTemplate   String    @default("✅ API XRS NORMALIZADA em {DATA} às {HORA}. O sistema voltou a operar normalmente.") @db.Text
  lastStatus                String    @default("UNKNOWN") // OK, ERROR, UNKNOWN
  lastCheckAt               DateTime?
  lastErrorAt               DateTime?
  lastRecoveryAt            DateTime?
  lastErrorMessage          String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}
// ── Support Tickets (chamados internos para o time de desenvolvimento) ──
model SupportTicket {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  priority    String   @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status      String   @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  tags        String   @default("[]") @db.Text
  imageUrls   String   @default("[]") @db.Text
  videoUrl    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// MÓDULO: CUPONS, PARCEIROS & ACOMPANHAMENTO DE VENDAS
// ══════════════════════════════════════════════════════════════════════════════

// ── Parceiros / Influenciadores / Afiliados ──
model Partner {
  id              String   @id @default(cuid())
  name            String
  tradeName       String?  // Nome fantasia
  type            String   @default("OTHER") // INFLUENCER | COMPANY | INDIVIDUAL | AFFILIATE | EMPLOYEE | CLIENT | AMBASSADOR | REPRESENTATIVE | OTHER
  cpf             String?
  cnpj            String?
  email           String?  @unique
  whatsapp        String?
  phone           String?
  company         String?
  position        String?  // Cargo
  city            String?
  state           String?
  country         String?  @default("BR")

  // Redes sociais
  instagram       String?
  tiktok          String?
  youtube         String?
  linkedin        String?
  website         String?
  notes           String?  @db.Text

  // Dados bancários (opcionais)
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  pixKey          String?
  bankHolder      String?
  bankHolderDoc   String?

  // Comissão
  commissionEnabled         Boolean @default(false)
  commissionType            String? // PERCENTAGE | FIXED
  commissionValue           Float?  // ex: 10 (10%) ou 50.00 (R$50)
  commissionBase            String? @default("PAID") // GROSS | NET | PAID | FIXED
  commissionReleaseDelayDays Int?   @default(7)

  // Portal de acesso
  referralToken         String?  @unique // Token longo para acesso via link seguro
  portalPasswordHash    String?          // Senha hashada para login no portal

  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  coupons         Coupon[]
  couponUsages    CouponUsage[]
  commissions     Commission[]
  referralEvents  ReferralEvent[]

  @@index([type])
  @@index([status])
  @@index([email])
  @@index([referralToken])
}

// ── Cupons de Desconto ──
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique  // Código do cupom (ex: JOAO10)
  name            String             // Nome interno
  description     String?  @db.Text

  // Tipo e benefício
  couponType      String   @default("PROMOTIONAL") // INFLUENCER | COMPANY | INDIVIDUAL | AFFILIATE | EMPLOYEE | CLIENT | CAMPAIGN | COURTESY | FREE | PROMOTIONAL | OTHER
  discountType    String   @default("PERCENTAGE")  // PERCENTAGE | FIXED_VALUE | FREE
  discountValue   Float?   // ex: 10 (10%) ou 50.00 (R$50)
  maxDiscount     Float?   // Teto do desconto (ex: R$300 em cupom de 20%)

  // Regras comerciais
  minimumOrderValue Float?  // Valor mínimo do pedido
  stackable       Boolean  @default(false) // Pode combinar com outro cupom?

  // Categorias/produtos permitidos (JSON arrays)
  allowedCategories String? @db.Text // JSON: ["EDCI", "FDAR"] ou null = todos
  excludedCategories String? @db.Text // JSON: ["XSAR"] blacklist

  // Validade
  startsAt        DateTime?
  expiresAt       DateTime?
  hasExpiration   Boolean  @default(false)

  // Limites de uso
  maxUses             Int?  // Limite total
  maxUsesPerCustomer  Int?  @default(1) // Limite por cliente
  maxUsesPerDay       Int?  // Limite diário
  maxUsesPerMonth     Int?  // Limite mensal
  currentUses         Int   @default(0) // Contador atual

  // Status
  status          String   @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | PAUSED | EXPIRED | BLOCKED | CLOSED

  // Vinculação
  partnerId       String?
  partner         Partner? @relation(fields: [partnerId], references: [id])
  campaign        String?  // Nome da campanha (ex: BLACK FRIDAY 2026)

  // Cortesia/100%
  requiresApproval Boolean @default(false) // Exigir autorização admin para uso

  // Audit
  createdBy       String?  // userId de quem criou
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  usages          CouponUsage[]
  commissions     Commission[]
  referralEvents  ReferralEvent[]
  auditLogs       CouponAuditLog[]

  @@index([code])
  @@index([status])
  @@index([couponType])
  @@index([partnerId])
  @@index([campaign])
  @@index([startsAt, expiresAt])
}

// ── Utilizações de Cupom (cada uso = 1 registro) ──
model CouponUsage {
  id                  String   @id @default(cuid())

  couponId            String
  coupon              Coupon   @relation(fields: [couponId], references: [id])

  partnerId           String?
  partner             Partner? @relation(fields: [partnerId], references: [id])

  reservationId       String?  // FK para LocalReservation.id
  resNumber           String?  // Snapshot do número da reserva

  // Snapshot das condições no momento do uso (imutável)
  couponCodeSnapshot  String
  discountTypeSnapshot String?
  discountValueSnapshot Float?

  // Valores
  originalValue       Float    // Valor original do pedido
  discountAmount      Float    // Valor do desconto concedido
  finalValue          Float    // Valor efetivamente pago

  // Cliente (dados parciais — LGPD)
  customerEmail       String?
  customerNamePartial String?  // Ex: "Mat*** C***"

  // Comissão snapshot
  commissionAmount    Float?   @default(0)

  // Status
  status              String   @default("CONFIRMED") // PENDING | CONFIRMED | PAID | CANCELLED | REFUNDED | COURTESY

  usedAt              DateTime @default(now())

  // Relations
  commissions         Commission[]

  @@index([couponId])
  @@index([partnerId])
  @@index([reservationId])
  @@index([status])
  @@index([usedAt])
}

// ── Comissões ──
model Commission {
  id                String   @id @default(cuid())

  partnerId         String
  partner           Partner  @relation(fields: [partnerId], references: [id])

  couponId          String?
  coupon            Coupon?  @relation(fields: [couponId], references: [id])

  couponUsageId     String?
  couponUsage       CouponUsage? @relation(fields: [couponUsageId], references: [id])

  amount            Float    // Valor da comissão
  status            String   @default("FORECAST") // FORECAST | PENDING | RELEASED | PAID | CANCELLED | REFUNDED

  availableAt       DateTime? // Data em que será liberada
  paidAt            DateTime?
  paymentReference  String?   // Referência do pagamento (comprovante, nº transação)
  notes             String?   @db.Text
  paidBy            String?   // userId de quem pagou

  createdAt         DateTime @default(now())

  @@index([partnerId])
  @@index([status])
  @@index([availableAt])
  @@index([couponId])
}

// ── Eventos de Referral / Tracking ──
model ReferralEvent {
  id          String   @id @default(cuid())

  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id])

  couponId    String?
  coupon      Coupon?  @relation(fields: [couponId], references: [id])

  sessionId   String?  // ID da sessão do navegador
  event       String   // LINK_OPENED | COUPON_VIEWED | CHECKOUT_STARTED | COUPON_APPLIED | PURCHASE_COMPLETED

  // UTMs e origem
  source      String?  // utm_source
  medium      String?  // utm_medium
  campaign    String?  // utm_campaign
  content     String?  // utm_content
  referrer    String?  // HTTP referrer

  ipAddress   String?
  userAgent   String?  @db.Text
  metadata    Json?    // Dados extras

  createdAt   DateTime @default(now())

  @@index([partnerId])
  @@index([couponId])
  @@index([event])
  @@index([sessionId])
  @@index([createdAt])
}

// ── Auditoria de Cupons ──
model CouponAuditLog {
  id        String   @id @default(cuid())

  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])

  userId    String?  // Quem fez a ação
  action    String   // CREATED | UPDATED | ACTIVATED | PAUSED | CLOSED | BLOCKED | DUPLICATED | USED | CANCELLED

  oldData   Json?    // Estado anterior
  newData   Json?    // Estado novo

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([action])
  @@index([createdAt])
}

// ── Módulo Inteligente de Recusas e Vendas Perdidas ──
model TransactionRejectionLog {
  id                      String    @id @default(cuid())
  createdAt               DateTime  @default(now()) @map("created_at")
  eventId                 String?   @unique @map("event_id")
  attemptNumber           Int?      @map("attempt_number")
  customerName            String?   @map("customer_name")
  customerEmail           String?   @map("customer_email")
  customerPhone           String?   @map("customer_phone")
  reservationId           String?   @map("reservation_id")
  cieloPaymentId          String?   @map("cielo_payment_id")
  cieloMerchantOrderId    String?   @map("cielo_merchant_order_id")
  amount                  Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod           String?   @map("payment_method")
  provider                String
  cardBrand               String?   @map("card_brand")
  rejectionCategory       String    @map("rejection_category")
  rejectionType           String?   @map("rejection_type")
  canRetry                Boolean?  @map("can_retry")
  returnCodeRaw           String?   @map("return_code_raw")
  returnCodeNormalized    String?   @map("return_code_normalized")
  returnMessage           String?   @map("return_message") @db.Text
  dictionaryMessage       String?   @map("dictionary_message") @db.Text
  customerMessage         String?   @map("customer_message") @db.Text
  customerFriendlyMessage String?   @map("customer_friendly_message") @db.Text
  friendlyExplanation     String?   @map("friendly_explanation") @db.Text
  recommendedAction       String?   @map("recommended_action") @db.Text
  actionStatus            String?   @map("action_status") @db.Text
  responsibility          String?   @map("responsibility")
  rootCause               String?   @map("root_cause") @db.Text
  aiBehaviorInstruction   String?   @map("ai_behavior_instruction") @db.Text
  retryPolicyText         String?   @map("retry_policy_text")
  mappingStatus           String?   @default("MAPPED") @map("mapping_status")
  mappingConfidence       Decimal?  @map("mapping_confidence") @db.Decimal(5, 2)
  httpStatus              Int?      @map("http_status")
  sourceEndpoint          String?   @map("source_endpoint")
  rawPayload              Json?     @map("raw_payload")
  fingerprint             String?

  @@index([createdAt], name: "idx_trl_created_at")
  @@index([provider], name: "idx_trl_provider")
  @@index([cardBrand, returnCodeNormalized], name: "idx_trl_brand_code")
  @@index([rejectionCategory], name: "idx_trl_category")
  @@index([cieloMerchantOrderId], name: "idx_trl_order")
  @@index([cieloPaymentId], name: "idx_trl_payment")
  @@map("transaction_rejection_logs")
}

model RejectionCodeDictionary {
  id                      String    @id @default(cuid())
  provider                String?   @default("Cielo")
  cardBrand               String    @map("card_brand")
  codeDisplay             String    @map("code_display")
  codeNormalized          String?   @map("code_normalized")
  aliases                 Json?
  rejectionType           String?   @map("rejection_type")
  technicalMessage        String?   @map("technical_message") @db.Text
  customerMessage         String?   @map("customer_message") @db.Text
  rejectionCategory       String?   @map("rejection_category")
  friendlyExplanation     String?   @map("friendly_explanation") @db.Text
  recommendedAction       String?   @map("recommended_action") @db.Text
  actionStatus            String?   @map("action_status") @db.Text
  responsibility          String?   @map("responsibility")
  rootCause               String?   @map("root_cause") @db.Text
  aiBehaviorInstruction   String?   @map("ai_behavior_instruction") @db.Text
  customerFriendlyMessage String?   @map("customer_friendly_message") @db.Text
  retryPolicyText         String?   @map("retry_policy_text")
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([cardBrand, codeNormalized], name: "idx_rcd_brand_code")
  @@map("rejection_code_dictionary")
}

